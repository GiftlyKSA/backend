# Giftly environment template: copy to .env for local development.
# Never commit real credentials or bake .env into a container image.
# Blank secrets must be generated/supplied before startup. Examples are not credentials.
# Production: inject secrets using the hosting platform secret store at runtime.
# Settings reads .env; server controls WEB_CONCURRENCY, GUNICORN_TIMEOUT and
# FORWARDED_ALLOW_IPS must be set/exported in the actual process environment.
# Compose uses its own explicit local configuration; copying this file does not
# override every Compose value. No dormant payment-provider variables are defined.

# --- Runtime and logging ---

# Required runtime mode: development, test or production. Development exposes otp_dev and allows
# all browser origins; use production on deployed services.
ENVIRONMENT=development

# Enable SQL statement logging outside production (bound values are hidden). Example: false in
# production.
DEBUG=true

# Application and entrypoint log severity. Example: WARNING for fewer messages, DEBUG for
# investigation.
LOG_LEVEL=INFO

# Gunicorn API worker count for the default container entrypoint. Example: 3; ignored when a
# custom service command is supplied.
WEB_CONCURRENCY=3

# Gunicorn worker timeout in seconds for the default entrypoint. Example: 80; ignored by custom
# Uvicorn/Taskiq commands.
GUNICORN_TIMEOUT=80

# --- Database and shared Redis state ---

# Async PostgreSQL connection URL for API, workers and migrations. Example below is local-only;
# use provisioned credentials in production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/giftly

# Redis connection URL for OTP, throttles, locks, events and Taskiq. Example below is
# local-only; use rediss:// for a TLS-enabled service.
REDIS_URL=redis://:changeme@localhost:6379/0

# PostgreSQL persistent connections per engine/process, from 1 to 100. Example: 5.
# Budget all API workers, worker jobs and replicas against the database connection limit.
DB_POOL_SIZE=5

# Additional temporary connections per engine/process, from 0 to 100. Example: 0 for a
# fixed pool; 10 preserves existing behavior. Does not change the database server limit.
DB_MAX_OVERFLOW=10

# Maximum seconds waiting for a free pooled connection, greater than 0 and at most 60.
# Example: 30; this does not set a SQL statement or database connection timeout.
DB_POOL_TIMEOUT_SECONDS=30

# --- Production email/SMS/push transport timeouts ---

# HTTP connect/read/write/pool timeout in seconds for the production email, SMS and push
# clients. Example: 10; must be greater than 0 and at most 15. Existing job deadlines still
# apply; this is not a total end-to-end timeout and does not affect S3 or Taskiq queue reads.
INTEGRATION_HTTP_TIMEOUT_SECONDS=10

# --- JWT authentication ---

# Pinned token signing algorithm: HS256 or RS256. Example: RS256 with both PEM keys supplied.
JWT_ALGORITHM=HS256

# Secret for HS256; at least 32 bytes. Example format: a separately generated random
# 64-character hex value (never commit it).
JWT_SECRET=

# Signing PEM key for RS256 only. Example: a quoted multiline RSA private PEM supplied through
# the deployment secret store.
# JWT_PRIVATE_KEY=

# Verification PEM key for RS256 only. Example: the matching quoted multiline public PEM; never
# use the private key here.
# JWT_PUBLIC_KEY=

# Access-token lifetime in minutes. Example: 30 expires an access token after half an hour.
JWT_ACCESS_TTL_MINUTES=30

# Refresh-token lifetime in days. Example: 30 permits renewal until its expiry, subject to
# rotation/revocation.
JWT_REFRESH_TTL_DAYS=30

# Expected issuer claim when signing and verifying tokens. Example: giftly; changing it
# invalidates existing tokens.
JWT_ISSUER=giftly

# Expected audience claim when signing and verifying tokens. Example: giftly; changing it
# invalidates existing tokens.
JWT_AUDIENCE=giftly

# Retention in days for expired or consumed refresh tokens before scheduled cleanup. Example:
# 30.
REFRESH_TOKEN_RETENTION_DAYS=30

# --- Sensitive field encryption and identity fingerprints ---

# Secret JSON map of key version to Base64-encoded 32-byte AES key. Example structure:
# {"1":"<base64-encoded-32-byte-key>"}; keep old versions while encrypted data still needs them.
FIELD_ENCRYPTION_KEYS=

# Key-map version used for new encrypted values. Example: 1 must exist in FIELD_ENCRYPTION_KEYS;
# use the rotation command for existing data.
FIELD_ENCRYPTION_KEY_VERSION=1

# Secret used to fingerprint identity numbers; at least 32 bytes, distinct from encryption keys.
# Example format: its own random 64-character hex value; do not change without a data plan.
IDENTITY_FINGERPRINT_PEPPER=

# --- Phone OTP authentication ---

# Optional dedicated secret for hashing Redis OTP values; at least 32 ASCII characters. Example
# format: a separate random 64-character hex value. If omitted, JWT_SECRET then the identity
# pepper is used.
OTP_HMAC_KEY=

# OTP validity and verification-attempt-key lifetime in seconds. Example: 60 expires a code
# after one minute.
OTP_TTL_SECONDS=60

# Maximum OTP requests per phone in the request window. Example: 3 requests per
# OTP_WINDOW_SECONDS.
OTP_MAX_PER_WINDOW=3

# OTP request-count window in seconds. Example: 300 is five minutes.
OTP_WINDOW_SECONDS=300

# Phone block duration after exceeding the OTP request limit. Example: 1800 is thirty minutes.
OTP_BLOCK_SECONDS=1800

# --- Production private S3 storage and signed CloudFront access ---

# AWS region containing the private bucket; required in production. Example: me-south-1.
AWS_REGION=

# Storage IAM access-key ID; required by the current adapter in production. Example format: the
# ID issued for a least-privilege storage identity.
AWS_ACCESS_KEY_ID=

# Secret paired with AWS_ACCESS_KEY_ID; required in production. Example: inject the
# vendor-issued value using the platform secret store.
AWS_SECRET_ACCESS_KEY=

# Private storage bucket name; required in production. Example: giftly-private-media.
S3_BUCKET_NAME=

# CloudFront hostname without scheme; required in production. Example: media.example.com.
CLOUDFRONT_DOMAIN=

# CloudFront public-key identifier used for signed read links; required in production. Example:
# the ID for the trusted key group public key.
CLOUDFRONT_KEY_PAIR_ID=

# RSA PEM signing secret matching the CloudFront public key; required in production. Example: a
# quoted PEM with literal \n separators, which this adapter expands.
CLOUDFRONT_PRIVATE_KEY=

# --- Production sndr.sh invoice email ---

# sndr.sh bearer API key; required in production. Example: inject the issued key through the
# platform secret store.
SNDR_API_KEY=

# HTTPS sndr.sh API base URL without credentials/query; required in production. Example below
# uses the official API host.
SNDR_BASE_URL=https://api.sndr.sh

# Verified sender email address; required in production. Example: invoices@example.com.
SNDR_FROM_EMAIL=

# Sender display name; required in production. Example: Giftly.
SNDR_FROM_NAME=

# Optional logical receipt template key passed to the email interface/test fake. Example:
# invoice_paid. The current sndr.sh adapter builds the PDF email directly and does not use
# vendor templates.
SNDR_INVOICE_PAID_TEMPLATE_KEY=

# --- Production SMS and push adapters ---

# Bearer key for the SMS adapter; required in production. Example: the configured SMS service
# issued credential.
SMS_PROVIDER_KEY=

# HTTPS base used by SMS /send and push /functions/v1/push; required in production.
# Example: https://project.example.com. Confirm the actual vendor contract before live use.
SUPABASE_URL=

# Bearer service credential for the push dispatch adapter; required in production. Example:
# inject a private service key, never a public client key.
SUPABASE_SERVICE_KEY=

# --- Admin dashboard authentication and sessions ---

# Mount the admin dashboard when true. Example: false disables it; the template enables local
# development access.
ADMIN_DASHBOARD_ENABLED=true

# Dashboard login name when enabled. Example: admin locally; choose a different account name in
# production.
ADMIN_USERNAME=admin

# Dashboard password when enabled. Example: admin locally only; supply a strong unique
# production password through the secret store.
ADMIN_PASSWORD=admin

# Session/CSRF HMAC secret of at least 32 bytes when enabled. Example below is development-only;
# replace with a separate random secret in production.
ADMIN_SESSION_SECRET=local-development-admin-session-secret-change-me

# Base32 authenticator secret decoding to at least 20 bytes; required for production admin
# login. Example: inject an independently generated Base32 secret; development does not require
# TOTP.
ADMIN_TOTP_SECRET=

# Idle admin-session lifetime in minutes, within the existing absolute session cap. Example: 60.
ADMIN_SESSION_TTL_MINUTES=60

# --- Browser origins and trusted reverse proxies ---

# Comma-separated exact browser origins; production requires a non-wildcard allow-list. Example:
# https://app.example.com,https://ops.example.com. Development ignores this list.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gunicorn/Uvicorn process environment setting for trusted forwarded-header proxy addresses.
# Example: 127.0.0.1,10.0.0.5; never trust *. Export/set it in the server environment; Settings
# does not load it from .env for the server.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- HTTP and WebSocket protection ---

# Enable ordinary HTTP and admin HTTP throttling. Example: true in production; separate
# OTP/admin-login protections remain independent.
RATE_LIMIT_ENABLED=true

# Authenticated API request ceiling per window. Example: 60 requests per
# RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MAX_REQUESTS=60

# Authenticated API throttle window in seconds. Example: 60 is one minute.
RATE_LIMIT_WINDOW_SECONDS=60

# Anonymous API request ceiling per IP/window. Example: 30 per
# RATE_LIMIT_ANONYMOUS_WINDOW_SECONDS.
RATE_LIMIT_ANONYMOUS_MAX_REQUESTS=30

# Anonymous API throttle window in seconds. Example: 3600 is one hour.
RATE_LIMIT_ANONYMOUS_WINDOW_SECONDS=3600

# Admin HTTP request ceiling per window. Example: 100 per RATE_LIMIT_ADMIN_WINDOW_SECONDS.
RATE_LIMIT_ADMIN_MAX_REQUESTS=100

# Admin HTTP throttle window in seconds. Example: 60 is one minute.
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# Maximum HTTP request-body bytes. Example: 1048576 is 1 MiB; private media uploads go directly
# to storage.
MAX_REQUEST_BODY_BYTES=1048576

# Maximum incoming chat WebSocket messages per user/window. Example: 30 per
# WS_RATE_LIMIT_WINDOW_SECONDS.
WS_RATE_LIMIT_MAX_MESSAGES=30

# Chat WebSocket throttle window in seconds. Example: 60.
WS_RATE_LIMIT_WINDOW_SECONDS=60

# Maximum incoming chat WebSocket frame bytes. Example: 4096 is 4 KiB.
WS_MAX_FRAME_BYTES=4096

# --- Invoice pricing and limits (SAR amounts) ---

# Fraction applied to invoice item prices only. Example: 0.15 is 15%; not applied to delivery or
# other fees.
DEFAULT_VAT_RATE=0.15

# Fraction used to compute the platform service fee. Example: 0.05 is 5%, bounded by the fee
# minimum/maximum.
SERVICE_FEE_RATE=0.05

# Minimum computed service fee in SAR. Example: 5.00.
SERVICE_FEE_MIN_AMOUNT=5.00

# Maximum computed service fee in SAR. Example: 500.00.
SERVICE_FEE_MAX_AMOUNT=500.00

# Courier-settlement commission fraction. Example: 0.10 is 10%; changes affect future
# settlements.
PLATFORM_COMMISSION_RATE=0.10

# Maximum lines accepted in an invoice. Example: 20.
MAX_INVOICE_ITEMS=20

# Maximum invoice total in SAR. Example: 50000.00.
MAX_INVOICE_AMOUNT=50000.00

# Maximum individual item unit price in SAR. Example: 50000.00.
MAX_ITEM_UNIT_PRICE=50000.00

# Unpaid invoice/payment expiration delay in hours. Example: 48 is two days.
PAYMENT_EXPIRY_HOURS=48

# Delay in hours before eligible delivered orders are auto-approved. Example: 72 is three days.
AUTO_APPROVE_HOURS=72

# --- Wallet limits (SAR amounts) ---

# Minimum wallet top-up in SAR. Example: 100.00 (existing default preserved); production gateway
# operations remain disabled.
MIN_TOPUP_AMOUNT=100.00

# Maximum wallet top-up in SAR. Example: 20000.00.
MAX_TOPUP_AMOUNT=20000.00

# Minimum courier withdrawal in SAR; cannot be below 50.00. Example: 50.00.
MIN_WITHDRAWAL_AMOUNT=50.00

# Maximum courier withdrawal in SAR; must be at least the minimum. Example: 20000.00.
MAX_WITHDRAWAL_AMOUNT=20000.00

# --- Private media size and duration limits ---

# Maximum general proof/request image upload size in bytes. Example: 10485760 is 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Maximum bytes per chat image; may be reduced, never above 10 MiB. Example: 10485760.
CHAT_IMAGE_MAX_UPLOAD_BYTES=10485760

# Maximum bytes per chat video; may be reduced, never above 120 MiB. Example: 125829120.
CHAT_VIDEO_MAX_UPLOAD_BYTES=125829120

# Maximum bytes per recorded voice note; may be reduced, never above 10 MiB. Example: 10485760.
CHAT_AUDIO_MAX_UPLOAD_BYTES=10485760

# Maximum chat-video duration in seconds, bounded at 120. Example: 120 is two minutes.
CHAT_VIDEO_MAX_DURATION_SECONDS=120

# Maximum recorded voice-note duration in seconds, bounded at 120. Example: 120 is two minutes.
CHAT_AUDIO_MAX_DURATION_SECONDS=120
