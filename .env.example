# Copy to .env for development; never commit real secrets or bake them into images.
# CHANGE all test secrets and provider placeholders before production or storing real data.
# Production secrets: inject at runtime from the hosting platform secret store.
# Server controls must be exported; Compose supplies its own explicit development values.

# --- Runtime and logging ---

# Runtime mode: development, test or production; never deploy development mode.
ENVIRONMENT=development

# SQL debug logging; must be false in production.
DEBUG=true

# Application log severity.
LOG_LEVEL=INFO

# Default Gunicorn worker count; set in the process environment.
WEB_CONCURRENCY=3

# Default Gunicorn worker timeout (seconds); set in the process environment.
GUNICORN_TIMEOUT=80

# --- Database and shared Redis state ---

# Async PostgreSQL URL; replace local credentials in production.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/giftly

# Shared Redis URL; replace local credentials and use TLS in production.
REDIS_URL=redis://:changeme@localhost:6379/0

# Retained connections per engine/process (1-100); budget across all workers.
DB_POOL_SIZE=5

# Extra connections per engine/process (0-100); zero disables overflow.
DB_MAX_OVERFLOW=10

# Pool acquisition timeout (seconds, >0 to 60); not a query timeout.
DB_POOL_TIMEOUT_SECONDS=30

# --- Production email/SMS/push transport timeouts ---

# Email/SMS/push HTTP phase timeout (seconds, >0 to 15); job deadlines still apply.
INTEGRATION_HTTP_TIMEOUT_SECONDS=10

# --- Payment gateway ---

# auto: simulation in development/test, disabled in production. Explicit: disabled/dhamen.
PAYMENT_PROVIDER=auto

# Stop new payments while retaining configured-provider recovery for existing sessions.
PAYMENT_CHECKOUTS_ENABLED=true

# Dhamen vendor mode: testing or production; independent of application ENVIRONMENT.
# Production selection is rejected until vendor authentication is verified.
DHAMEN_ENVIRONMENT=testing

# Testing defaults to https://dhamendemo.elm.sa; optional override below.
# Production requires its official API origin and never falls back to testing.
DHAMEN_TEST_BASE_URL=
DHAMEN_PRODUCTION_BASE_URL=

# Credentials must belong to the selected vendor mode; never copy Postman secrets.
DHAMEN_APP_ID=
DHAMEN_APP_KEY=
DHAMEN_CLIENT_ID=

# Exact allowed HTTPS checkout hosts, comma-separated; no wildcards.
DHAMEN_CHECKOUT_HOSTS=checkout.dhamen-testing.example.com

# HTTPS customer return page; returning here does not prove successful payment.
DHAMEN_RETURN_URL=

# Register this server callback URL with Dhamen; never call it from the mobile UI.
DHAMEN_WEBHOOK_URL=https://api.giftly.example.com/api/webhooks/dhamen

# --- JWT authentication ---

# Pinned signing algorithm: HS256 or RS256.
JWT_ALGORITHM=HS256

# HS256 signing secret (32+ bytes); CHANGE this test value before production.
JWT_SECRET=local-development-jwt-secret-change-me

# RS256 private PEM; replace placeholder before enabling RS256.
# JWT_PRIVATE_KEY=development-only-placeholder-replace-with-rsa-private-pem

# RS256 public PEM matching the private key; replace placeholder before use.
# JWT_PUBLIC_KEY=development-only-placeholder-replace-with-rsa-public-pem

# Access-token lifetime (minutes).
JWT_ACCESS_TTL_MINUTES=30

# Refresh-token lifetime (days).
JWT_REFRESH_TTL_DAYS=30

# Expected token issuer; changing it invalidates existing tokens.
JWT_ISSUER=giftly

# Expected token audience; changing it invalidates existing tokens.
JWT_AUDIENCE=giftly

# Expired/consumed refresh-token retention (days).
REFRESH_TOKEN_RETENTION_DAYS=30

# --- Sensitive field encryption ---

# Versioned Base64 AES-256 keys; CHANGE the public test key before storing real data.
FIELD_ENCRYPTION_KEYS='{"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}'

# Active encryption-key version; retain old keys until data is rotated.
FIELD_ENCRYPTION_KEY_VERSION=1

# --- Phone OTP authentication ---

# OTP HMAC secret (32+ ASCII characters); CHANGE test value before production.
OTP_HMAC_KEY=local-development-otp-hmac-secret-change-me

# OTP validity (seconds).
OTP_TTL_SECONDS=60

# OTP request limit per phone/window.
OTP_MAX_PER_WINDOW=3

# OTP request-count window (seconds).
OTP_WINDOW_SECONDS=300

# Phone block duration after exceeding OTP requests (seconds).
OTP_BLOCK_SECONDS=1800

# --- Production private S3 storage and signed CloudFront access ---

# Private bucket region; replace for production.
AWS_REGION=me-south-1

# S3 access-key ID; CHANGE dummy credential before production.
AWS_ACCESS_KEY_ID=development-only-aws-access-key-change-me

# S3 secret access key; CHANGE dummy credential before production.
AWS_SECRET_ACCESS_KEY=development-only-aws-secret-key-change-me

# Private bucket name; replace for production.
S3_BUCKET_NAME=giftly-development-private-media

# CDN hostname without scheme; replace for production.
CLOUDFRONT_DOMAIN=media.example.com

# CDN public-key ID; replace placeholder for production.
CLOUDFRONT_KEY_PAIR_ID=development-key-id-change-me

# CDN RSA private PEM; replace invalid placeholder; literal \n separators supported.
CLOUDFRONT_PRIVATE_KEY=development-only-placeholder-replace-with-rsa-pem

# --- Production sndr.sh invoice email ---

# sndr.sh bearer key; CHANGE dummy credential before production.
SNDR_API_KEY=development-only-sndr-api-key-change-me

# sndr.sh HTTPS API base URL.
SNDR_BASE_URL=https://api.sndr.sh

# Verified sender address; replace for production.
SNDR_FROM_EMAIL=invoices@example.com

# Email sender display name.
SNDR_FROM_NAME=Giftly

# Logical receipt label; current sndr.sh adapter does not select vendor templates.
SNDR_INVOICE_PAID_TEMPLATE_KEY=invoice_paid_receipt

# --- Production SMS and push adapters ---

# SMS bearer key; CHANGE dummy credential before production.
SMS_PROVIDER_KEY=development-only-sms-provider-key-change-me

# SMS/push HTTPS base URL; replace placeholder and verify vendor contracts.
SUPABASE_URL=https://project.example.com

# Push service bearer key; CHANGE dummy credential before production.
SUPABASE_SERVICE_KEY=development-only-push-service-key-change-me

# --- Admin dashboard authentication and sessions ---

# Enable the admin dashboard.
ADMIN_DASHBOARD_ENABLED=true

# Admin login name; CHANGE development default before production.
ADMIN_USERNAME=admin

# Admin password; CHANGE development default before production.
ADMIN_PASSWORD=admin

# Session/CSRF secret (32+ bytes); CHANGE test value before production.
ADMIN_SESSION_SECRET=local-development-admin-session-secret-change-me

# Base32 TOTP seed (20+ decoded bytes); CHANGE test value before production.
ADMIN_TOTP_SECRET=GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ

# Idle admin-session lifetime (minutes); absolute cap still applies.
ADMIN_SESSION_TTL_MINUTES=60

# --- Browser origins and trusted reverse proxies ---

# Exact browser origins, comma-separated; no production wildcard; ignored in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Trusted proxy addresses; set in process environment; never use *.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# --- HTTP and WebSocket protection ---

# Enable HTTP throttling; OTP/admin-login limits remain separate.
RATE_LIMIT_ENABLED=true

# Authenticated API requests per window.
RATE_LIMIT_MAX_REQUESTS=60

# Authenticated API rate-limit window (seconds).
RATE_LIMIT_WINDOW_SECONDS=60

# Anonymous API requests per IP/window.
RATE_LIMIT_ANONYMOUS_MAX_REQUESTS=30

# Anonymous API rate-limit window (seconds).
RATE_LIMIT_ANONYMOUS_WINDOW_SECONDS=3600

# Admin HTTP requests per window.
RATE_LIMIT_ADMIN_MAX_REQUESTS=100

# Admin HTTP rate-limit window (seconds).
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60

# HTTP body limit (bytes); private media uploads bypass the API.
MAX_REQUEST_BODY_BYTES=1048576

# Incoming chat WebSocket messages per user/window.
WS_RATE_LIMIT_MAX_MESSAGES=30

# Chat WebSocket rate-limit window (seconds).
WS_RATE_LIMIT_WINDOW_SECONDS=60

# Incoming chat WebSocket frame limit (bytes).
WS_MAX_FRAME_BYTES=4096

# --- Invoice pricing and limits (SAR amounts) ---

# Service-fee fraction, bounded by fee minimum/maximum.
SERVICE_FEE_RATE=0.05

# Minimum service fee (SAR).
SERVICE_FEE_MIN_AMOUNT=5.00

# Maximum service fee (SAR).
SERVICE_FEE_MAX_AMOUNT=500.00

# Courier settlement commission fraction.
PLATFORM_COMMISSION_RATE=0.10

# Maximum invoice lines.
MAX_INVOICE_ITEMS=20

# Maximum invoice total (SAR).
MAX_INVOICE_AMOUNT=50000.00

# Maximum item unit price (SAR).
MAX_ITEM_UNIT_PRICE=50000.00

# Unpaid invoice/payment expiry (hours).
PAYMENT_EXPIRY_HOURS=48

# Delay before eligible delivered orders are auto-approved (hours).
AUTO_APPROVE_HOURS=72

# --- Wallet limits (SAR amounts) ---

# Minimum wallet top-up (SAR); production payments remain disabled.
MIN_TOPUP_AMOUNT=100.00

# Maximum wallet top-up (SAR).
MAX_TOPUP_AMOUNT=20000.00

# Minimum courier withdrawal (SAR); cannot be below 50.
MIN_WITHDRAWAL_AMOUNT=50.00

# Maximum courier withdrawal (SAR); must cover the minimum.
MAX_WITHDRAWAL_AMOUNT=20000.00

# --- Private media size and duration limits ---

# General proof/request image limit (bytes).
MAX_UPLOAD_BYTES=10485760

# Chat image limit (bytes); cannot exceed 10 MiB.
CHAT_IMAGE_MAX_UPLOAD_BYTES=10485760

# Chat video limit (bytes); cannot exceed 120 MiB.
CHAT_VIDEO_MAX_UPLOAD_BYTES=125829120

# Recorded voice-note limit (bytes); cannot exceed 10 MiB.
CHAT_AUDIO_MAX_UPLOAD_BYTES=10485760

# Chat video duration limit (seconds); cannot exceed 120.
CHAT_VIDEO_MAX_DURATION_SECONDS=120

# Voice-note duration limit (seconds); cannot exceed 120.
CHAT_AUDIO_MAX_DURATION_SECONDS=120
